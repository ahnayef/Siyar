rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: The following rule is very permissive and allows all authenticated users
    // to read and write all data. This is generally not recommended for production
    // environments. You mentioned you are disabling/managing rules elsewhere.
    // Replace this with appropriate security rules for your application.
    match /{document=**} {
      allow read, write: if request.auth != null;
      // For completely open access (e.g., initial development, if you are truly disabling all checks):
      // allow read, write: if true;
    }
  }
}
